#!/usr/bin/env python3
"""ccswitch - switch the Claude Code login between your own accounts without a browser.

Claude Code keeps its login in one macOS Keychain item and re-reads it every
~30 seconds in every running session. ccswitch snapshots that item into a
Keychain slot per account and swaps the chosen slot back into the live item,
so every open session continues on the other account with its context intact.

Nothing here talks to Anthropic. The only network path is the real
`claude auth login`, which is the fallback whenever a slot has died.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION = "0.1.0"

LIVE_SERVICE = "Claude Code-credentials"   # the item Claude Code reads and writes
SLOT_SERVICE = "ccswitch"                  # our slots: one item per account email
SLOT_FORMAT = 1
STDIN_LIMIT = 4096                         # `security -i` line limit; argv above it, like Claude Code
EMAIL_RE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,255}\.[A-Za-z]{2,}$")
ACCOUNT_RE = re.compile(r"^[A-Za-z0-9._%+@-]{1,320}$")   # what may become a Keychain account name
ALIAS_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
RESERVED = {"save", "switch", "list", "status", "login", "remove", "doctor", "statusline-tee", "watch", "daemon",
            "alias", "unalias", "hud", "next"}


class Fail(Exception):
    """A user-facing error. The message never contains a token."""


# ----------------------------------------------------------------------------- paths

def config_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def config_json() -> Path:
    """`.claude.json` sits inside CLAUDE_CONFIG_DIR when that is set, else at ~."""
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        return config_dir() / ".claude.json"
    return Path.home() / ".claude.json"


def index_path() -> Path:
    home = os.environ.get("CCSWITCH_HOME")
    base = Path(home) if home else Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ccswitch"
    return base / "slots.json"


def security_bin() -> str:
    return os.environ.get("CCSWITCH_SECURITY") or shutil.which("security") or "/usr/bin/security"


def claude_bin() -> str:
    return os.environ.get("CCSWITCH_CLAUDE") or shutil.which("claude") or "claude"


# ----------------------------------------------------------------------------- keychain

def _run(args: list[str], *, input_text: str | None = None, timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(args, input=input_text, capture_output=True, text=True, timeout=timeout)


def _check_account(account: str) -> str:
    """Refuse anything that could not be a Keychain account name we wrote: the value
    is interpolated into a `security -i` line, so quotes and control characters
    must never reach it."""
    if not ACCOUNT_RE.match(account):
        raise Fail("refusing an account name with characters outside [A-Za-z0-9._%+@-]")
    return account


def check_email(email: str) -> str:
    email = email.strip().lower()
    if not EMAIL_RE.match(email):
        raise Fail(f"'{email}' is not an email address")
    return email


def kc_read(service: str, account: str | None = None) -> str | None:
    """The password of a generic item, or None when there is no such item."""
    if account is not None:
        _check_account(account)
    args = [security_bin(), "find-generic-password", "-s", service]
    if account:
        args += ["-a", account]
    args.append("-w")
    p = _run(args)
    if p.returncode != 0:
        if "could not be found" in (p.stderr + p.stdout) or p.returncode == 44:
            return None
        raise Fail(f"security find-generic-password failed (exit {p.returncode})")
    return p.stdout.rstrip("\n")


def kc_account(service: str) -> str | None:
    """The account name of an item, read from its attributes."""
    p = _run([security_bin(), "find-generic-password", "-s", service])
    if p.returncode != 0:
        return None
    m = re.search(r'"acct"<blob>="([^"]*)"', p.stdout)
    return m.group(1) if m else None


def kc_write(service: str, account: str, secret: str) -> None:
    """Create or update an item. The secret goes over stdin (`security -i`) so it
    never shows in `ps`; above the stdin line limit it goes as hex argv, which is
    what Claude Code itself does."""
    _check_account(account)
    hexed = secret.encode("utf-8").hex()
    line = f'add-generic-password -U -a "{account}" -s "{service}" -X {hexed}\n'
    if len(line) <= STDIN_LIMIT:
        p = _run([security_bin(), "-i"], input_text=line)
    else:
        p = _run([security_bin(), "add-generic-password", "-U", "-a", account, "-s", service, "-X", hexed])
    if p.returncode != 0:
        raise Fail(f"security add-generic-password failed (exit {p.returncode})")


def kc_delete(service: str, account: str) -> bool:
    _check_account(account)
    p = _run([security_bin(), "delete-generic-password", "-a", account, "-s", service])
    return p.returncode == 0


# ----------------------------------------------------------------------------- live credential

def _shape_ok(doc) -> bool:
    if not isinstance(doc, dict):
        return False
    o = doc.get("claudeAiOauth")
    return (isinstance(o, dict)
            and isinstance(o.get("accessToken"), str)
            and isinstance(o.get("refreshToken"), str))


def read_live() -> tuple[dict | None, str]:
    """(credential document or None, keychain account name)."""
    account = kc_account(LIVE_SERVICE) or os.environ.get("USER") or "unknown"
    raw = kc_read(LIVE_SERVICE)
    if raw is None:
        return None, account
    try:
        doc = json.loads(raw)
    except ValueError:
        raise Fail("the live credential is not JSON; refusing to touch it")
    if not _shape_ok(doc):
        raise Fail("the live credential does not have the claudeAiOauth shape this version knows; refusing to touch it")
    return doc, account


def write_live(doc: dict, account: str) -> None:
    if not _shape_ok(doc):
        raise Fail("refusing to write a credential without the claudeAiOauth shape")
    kc_write(LIVE_SERVICE, account, json.dumps(doc, separators=(",", ":")))


def oauth_dead(o: dict) -> str | None:
    """Why a claudeAiOauth block cannot be used, or None."""
    if not o.get("refreshToken"):
        return "its refresh token was blanked (Claude Code marked it dead)"
    exp = o.get("refreshTokenExpiresAt")
    if isinstance(exp, (int, float)) and exp and exp < now_ms():
        return "its refresh token expired on " + iso(exp)
    return None


# ----------------------------------------------------------------------------- claude.json

def load_config() -> dict:
    p = config_json()
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except ValueError:
        raise Fail(f"{p} is not valid JSON; refusing to rewrite it")


def save_config(d: dict) -> None:
    p = config_json()
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".claude.json.", dir=p.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(d, f, indent=2)
            f.write("\n")
        if p.exists():
            os.chmod(tmp, p.stat().st_mode & 0o777)
        os.replace(tmp, p)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def current_email(cfg: dict | None = None) -> str | None:
    cfg = load_config() if cfg is None else cfg
    e = (cfg.get("oauthAccount") or {}).get("emailAddress")
    return e.lower() if isinstance(e, str) and e else None


# ----------------------------------------------------------------------------- claude cli

def auth_status() -> dict:
    try:
        p = _run([claude_bin(), "auth", "status", "--json"], timeout=60)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    try:
        return json.loads(p.stdout) if p.stdout.strip() else {}
    except ValueError:
        return {}


# ----------------------------------------------------------------------------- slots

def load_index() -> dict:
    p = index_path()
    if not p.exists():
        return {"format": SLOT_FORMAT, "slots": {}}
    try:
        d = json.loads(p.read_text())
    except ValueError:
        raise Fail(f"{p} is not valid JSON")
    d["slots"] = {e: m for e, m in (d.get("slots") or {}).items() if EMAIL_RE.match(e)}
    return d


def save_index(d: dict) -> None:
    p = index_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="slots.", dir=p.parent)
    with os.fdopen(fd, "w") as f:
        json.dump(d, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def usage_summary(cu: dict | None) -> dict:
    """The two bars, from Claude Code's cached snapshot. Never a secret."""
    out = {}
    if not isinstance(cu, dict):
        return out
    u = cu.get("utilization") or {}
    for k in ("five_hour", "seven_day"):
        w = u.get(k) or {}
        if isinstance(w, dict) and "utilization" in w:
            out[k] = {"utilization": w.get("utilization"), "resets_at": w.get("resets_at")}
    if cu.get("fetchedAtMs"):
        out["fetched_at"] = iso(cu["fetchedAtMs"])
        out["fetched_at_ms"] = int(cu["fetchedAtMs"])
    return out


def slot_read(email: str) -> dict | None:
    raw = kc_read(SLOT_SERVICE, email)
    if raw is None:
        return None
    try:
        d = json.loads(raw)
    except ValueError:
        raise Fail(f"slot {email} is not JSON")
    if d.get("format") != SLOT_FORMAT or not _shape_ok(d.get("credentials")):
        raise Fail(f"slot {email} has a shape this version does not know")
    return d


def slot_write(email: str, slot: dict) -> None:
    kc_write(SLOT_SERVICE, email, json.dumps(slot, separators=(",", ":")))


def resolve_target(name: str, index: dict) -> str:
    """An exact email, or a unique case-insensitive prefix of one."""
    slots = index["slots"]
    n = name.lower()
    for email, m in slots.items():
        if m.get("alias") == n:
            return email
    if n in slots:
        return n
    if n.isdigit():
        ordered = sorted(slots)
        if 1 <= int(n) <= len(ordered):
            return ordered[int(n) - 1]
        raise Fail(f"no slot number {n}; `ccswitch list` numbers them 1-{len(ordered)}")
    hits = [e for e in slots if e.startswith(n) or e.split("@", 1)[0].startswith(n)]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise Fail(f"no slot matches '{name}'. Saved slots: {', '.join(sorted(slots)) or 'none'}")
    raise Fail(f"'{name}' is ambiguous: {', '.join(sorted(hits))}")


# ----------------------------------------------------------------------------- helpers

def sha256_hex(text: str) -> str:
    import hashlib
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def now_ms() -> int:
    return int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000)


def iso(ms) -> str:
    try:
        return dt.datetime.fromtimestamp(ms / 1000, dt.timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M")
    except (TypeError, ValueError, OSError):
        return "?"


def local(iso_text: str | None) -> str:
    if not iso_text:
        return "?"
    try:
        return dt.datetime.fromisoformat(iso_text).astimezone().strftime("%a %H:%M")
    except ValueError:
        return iso_text


def say(msg: str) -> None:
    print(msg, file=sys.stderr)


def confirm(prompt: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        raise Fail("not a terminal; pass -y to confirm non-interactively")
    try:
        return input(prompt + " [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def fallback_line(email: str) -> str:
    return f"  claude auth login --email {email} && ccswitch save"


# ----------------------------------------------------------------------------- commands

def do_save(as_email: str | None, quiet: bool = False) -> str:
    live, _ = read_live()
    if live is None:
        raise Fail("nothing is logged in; run `claude auth login --email <addr>` first")
    dead = oauth_dead(live["claudeAiOauth"])
    if dead:
        raise Fail(f"the live login cannot be saved: {dead}. Log in again:\n" + fallback_line(as_email or current_email() or "<addr>"))
    cfg = load_config()
    status = auth_status()
    email = (as_email or status.get("email") or current_email(cfg) or "").strip().lower()
    if not email:
        raise Fail("could not tell which account is logged in; pass --as <email>")
    email = check_email(email)
    slot = {
        "format": SLOT_FORMAT,
        "email": email,
        "saved_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "credentials": live,
        "oauthAccount": cfg.get("oauthAccount"),
        "cachedUsageUtilization": cfg.get("cachedUsageUtilization"),
        "status": {k: status.get(k) for k in ("orgName", "subscriptionType", "orgId") if status.get(k)},
    }
    slot_write(email, slot)
    index = load_index()
    usage = usage_summary(cfg.get("cachedUsageUtilization"))
    prior = (index["slots"].get(email) or {}).get("usage") or {}
    if prior.get("fetched_at_ms", 0) > usage.get("fetched_at_ms", 0):
        usage = prior          # the daemon's feed is fresher than Claude Code's cached snapshot
    alias = (index["slots"].get(email) or {}).get("alias")
    index["slots"][email] = {
        "saved_at": slot["saved_at"],
        "org": status.get("orgName") or (cfg.get("oauthAccount") or {}).get("organizationName"),
        "plan": status.get("subscriptionType") or live["claudeAiOauth"].get("subscriptionType"),
        "usage": usage,
        "refresh_expires_at": iso(live["claudeAiOauth"].get("refreshTokenExpiresAt")),
    }
    if alias:
        index["slots"][email]["alias"] = alias
    index["slots"][email]["token_hash"] = sha256_hex(live["claudeAiOauth"]["refreshToken"])
    save_index(index)
    if not quiet:
        say(f"saved slot {email} ({index['slots'][email].get('plan') or '?'}, {index['slots'][email].get('org') or '?'})")
    return email


def do_switch(name: str, assume_yes: bool, probe: bool, ask: bool = False) -> int:
    index = load_index()
    target = resolve_target(name, index) if name != "next" else next_target(index)
    live, account = read_live()
    cur = current_email()
    if live is not None and cur == target:
        say(f"already on {target}")
        return 0

    slot = slot_read(target)
    if slot is None:
        raise Fail(f"slot {target} is in the index but not in the Keychain. Recapture it:\n" + fallback_line(target))
    dead = oauth_dead(slot["credentials"]["claudeAiOauth"])
    if dead:
        say(f"slot {target} is dead: {dead}. Log in once, then save it again:")
        say(fallback_line(target))
        return 2

    meta = index["slots"].get(target, {})
    if ask and not assume_yes:
        u = meta.get("usage", {})
        bars = ", ".join(f"{k.replace('_', ' ')} {v.get('utilization')}% (resets {local(v.get('resets_at'))})"
                         for k, v in u.items() if isinstance(v, dict))
        say(f"{cur or '(nobody)'} -> {target}  [{meta.get('plan') or '?'} / {meta.get('org') or '?'}]"
            + (f"; last seen {bars}" if bars else ""))
        if not confirm("proceed?", False):
            say("aborted")
            return 1

    # 1. keep the outgoing login fresh in its slot (refresh tokens rotate)
    if live is not None and cur and oauth_dead(live["claudeAiOauth"]) is None:
        do_save(cur, quiet=True)

    # 2. the live item: only the claudeAiOauth block moves; every other key stays
    new_live = dict(live) if live is not None else {}
    new_live.update({k: v for k, v in slot["credentials"].items() if k != "claudeAiOauth"})
    new_live["claudeAiOauth"] = slot["credentials"]["claudeAiOauth"]
    write_live(new_live, account)

    # 3. the account label and the usage snapshot Claude Code keeps beside it
    cfg = load_config()
    if slot.get("oauthAccount"):
        cfg["oauthAccount"] = slot["oauthAccount"]
    if slot.get("cachedUsageUtilization"):
        cfg["cachedUsageUtilization"] = slot["cachedUsageUtilization"]
    else:
        cfg.pop("cachedUsageUtilization", None)
    save_config(cfg)

    # 4. read back: did the write land, and does Claude Code agree?
    check, _ = read_live()
    if check is None or check["claudeAiOauth"].get("refreshToken") != new_live["claudeAiOauth"].get("refreshToken"):
        say("warning: the live credential changed under us (a session was refreshing). Re-run the switch.")
        return 3
    status = auth_status()
    seen = (status.get("email") or "").lower()
    if status and (not status.get("loggedIn") or (seen and seen != target)):
        say(f"warning: claude auth status reports {seen or 'not logged in'}; if sessions do not follow, recapture:")
        say(fallback_line(target))
        return 3
    say(f"now on {target} (was {cur or 'nobody'}); open sessions follow within ~30s")

    if probe:
        ok = do_probe()
        if not ok:
            say(f"probe failed: the slot's token was refused. Log in once, then save:")
            say(fallback_line(target))
            return 2
        say("probe ok: the token works.")
    return 0


def do_probe() -> bool:
    """One tiny request as the new account. Opt-in: it spends a few tokens."""
    with tempfile.TemporaryDirectory() as d:
        try:
            p = subprocess.run(
                [claude_bin(), "-p", "Reply with the single word ok.", "--model", "haiku",
                 "--max-turns", "1", "--no-session-persistence"],
                cwd=d, capture_output=True, text=True, timeout=90,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return False
    return p.returncode == 0


def do_list() -> int:
    index = load_index()
    cur = current_email()
    if not index["slots"]:
        say("no slots saved yet. Log in to an account, then: ccswitch save")
        return 0
    rows = []
    for email, m in sorted(index["slots"].items()):
        u = m.get("usage", {})
        f = u.get("five_hour", {}) or {}
        s = u.get("seven_day", {}) or {}
        rows.append((
            "*" if email == cur else " ",
            email + (f"  ({m['alias']})" if m.get("alias") else ""),
            f"{m.get('plan') or '?'}",
            fmt_bar(f), fmt_bar(s),
            (m.get("saved_at") or "?")[:16].replace("T", " "),
        ))
    w = max(len(r[1]) for r in rows)
    print(f"     {'account':<{w}}  {'plan':<10} {'5h':<22} {'7d':<22} saved (UTC)")
    for i, r in enumerate(rows, 1):
        print(f"{r[0]} {i:>2} {r[1]:<{w}}  {r[2]:<10} {r[3]:<22} {r[4]:<22} {r[5]}")
    print("\n* = current. `ccswitch <alias|number|prefix|email|next>` switches. Usage is the snapshot from the last save; past its reset = empty.")
    return 0


def fmt_bar(w: dict) -> str:
    if not w or w.get("utilization") is None:
        return "-"
    reset = w.get("resets_at")
    try:
        past = reset and dt.datetime.fromisoformat(reset) < dt.datetime.now(dt.timezone.utc)
    except ValueError:
        past = False
    if past:
        return "0% (reset)"
    return f"{w['utilization']}% until {local(reset)}"


def do_status() -> int:
    status = auth_status()
    cfg = load_config()
    live, _ = read_live()
    email = status.get("email") or current_email(cfg) or "(nobody)"
    print(f"account : {email}")
    print(f"plan    : {status.get('subscriptionType') or '?'}  org: {status.get('orgName') or '?'}")
    print(f"keychain: {'present' if live else 'absent'}" + (f" ({oauth_dead(live['claudeAiOauth'])})" if live and oauth_dead(live['claudeAiOauth']) else ""))
    u = usage_summary(cfg.get("cachedUsageUtilization"))
    for k in ("five_hour", "seven_day"):
        if k in u:
            print(f"{k.replace('_', ' '):<8}: {fmt_bar(u[k])}")
    index = load_index()
    print(f"slots   : {len(index['slots'])} saved" + (f" ({'saved' if email.lower() in index['slots'] else 'this one is NOT saved - run: ccswitch save'})" if email != '(nobody)' else ""))
    return 0


def do_login(email: str) -> int:
    email = check_email(email)
    say(f"logging in as {email} through the real `claude auth login`.")
    say("  The browser decides the account: if claude.ai there is already signed in as someone else,")
    say("  sign out of claude.ai first (or use a private window). That does not touch Claude Code's logins.")
    p = subprocess.run([claude_bin(), "auth", "login", "--email", email])
    if p.returncode != 0:
        raise Fail(f"claude auth login exited {p.returncode}; nothing saved")
    got = do_save(None)
    if got != email:
        say(f"ccswitch: the browser signed in as {got}, not {email}. Saved it under {got}.")
        say(f"  To capture {email}: sign out of claude.ai in the browser, then run: ccswitch login {email}")
        return 3
    return 0


def do_remove(name: str, assume_yes: bool) -> int:
    index = load_index()
    target = resolve_target(name, index)
    if not confirm(f"forget slot {target}? (the account stays logged in wherever it is; only the saved copy goes)", assume_yes):
        say("aborted")
        return 1
    kc_delete(SLOT_SERVICE, target)
    index["slots"].pop(target, None)
    save_index(index)
    say(f"removed slot {target}")
    return 0


def check_alias(name: str) -> str:
    name = name.strip().lower()
    if not ALIAS_RE.match(name):
        raise Fail("an alias is 1-32 characters: a letter, then letters, digits, '_' or '-'")
    if name in RESERVED:
        raise Fail(f"'{name}' is a ccswitch command; pick another alias")
    return name


def do_alias(name: str | None, target: str | None) -> int:
    index = load_index()
    if name is None:
        rows = [(m["alias"], e) for e, m in sorted(index["slots"].items()) if m.get("alias")]
        if not rows:
            say("no aliases. Set one with: ccswitch alias <name> <email|prefix|number>")
            return 0
        w = max(len(a) for a, _ in rows)
        for a, e in sorted(rows):
            print(f"{a:<{w}}  {e}")
        return 0
    name = check_alias(name)
    if target is None:
        raise Fail("usage: ccswitch alias <name> <email|prefix|number>")
    email = resolve_target(target, index)
    moved = None
    for e, m in index["slots"].items():
        if m.get("alias") == name and e != email:
            m.pop("alias", None)
            moved = e
    old = index["slots"][email].get("alias")
    index["slots"][email]["alias"] = name
    save_index(index)
    say(f"{name} -> {email}" + (f" (was {old})" if old and old != name else "") + (f"; taken from {moved}" if moved else ""))
    return 0


def do_unalias(name: str) -> int:
    name = name.strip().lower()
    index = load_index()
    for e, m in index["slots"].items():
        if m.get("alias") == name:
            m.pop("alias", None)
            save_index(index)
            say(f"removed alias {name} from {e}")
            return 0
    raise Fail(f"no alias '{name}'")


def do_doctor() -> int:
    problems = 0
    if not shutil.which(security_bin()) and not os.path.exists(security_bin()):
        print("x security: not found (ccswitch needs the macOS Keychain CLI)")
        problems += 1
    else:
        print(f"ok security: {security_bin()}")
    cb = shutil.which(claude_bin()) or claude_bin()
    print(f"{'ok' if shutil.which(claude_bin()) else 'x '} claude: {cb}")
    try:
        live, account = read_live()
        if live is None:
            print("x live login: no Keychain item (nobody is logged in)")
            problems += 1
        else:
            dead = oauth_dead(live["claudeAiOauth"])
            print(f"{'x ' if dead else 'ok'} live login: item for account '{account}', {current_email() or 'email unknown'}" + (f" - {dead}" if dead else ""))
            problems += bool(dead)
    except Fail as e:
        print(f"x live login: {e}")
        problems += 1
    index = load_index()
    print(f"ok index: {index_path()} ({len(index['slots'])} slots)")
    for email in sorted(index["slots"]):
        try:
            s = slot_read(email)
        except Fail as e:
            print(f"x slot {email}: {e}")
            problems += 1
            continue
        if s is None:
            print(f"x slot {email}: in the index but missing from the Keychain")
            problems += 1
            continue
        dead = oauth_dead(s["credentials"]["claudeAiOauth"])
        print(f"{'x ' if dead else 'ok'} slot {email}: saved {s.get('saved_at')}" + (f" - {dead}; recapture with: {fallback_line(email).strip()}" if dead else ""))
        problems += bool(dead)
    return 1 if problems else 0


# ----------------------------------------------------------------------------- watch: the feed

def sessions_dir() -> Path:
    return index_path().parent / "sessions"


def statusline_record() -> Path:
    """Where the original status-line command is kept while the tee is installed."""
    return index_path().parent / "statusline.json"


def settings_path() -> Path:
    return config_dir() / "settings.json"


def do_statusline_tee() -> int:
    """Runs as the status-line command, every ~10s per session. Records the feed
    Claude Code hands it to sessions/<id>.json, then runs the original command
    with the same stdin. Must never break the status line: every failure is
    swallowed and the original still runs."""
    raw = sys.stdin.read()
    try:
        d = json.loads(raw) if raw.strip() else {}
        sid = d.get("session_id")
        if isinstance(sid, str) and re.match(r"^[A-Za-z0-9-]{1,80}$", sid):
            rl = d.get("rate_limits") or {}
            cw = d.get("context_window") or {}
            rec = {
                "session_id": sid,
                "ts": int(dt.datetime.now(dt.timezone.utc).timestamp()),
                "pid": os.getppid(),
                "cwd": d.get("cwd"),
                "transcript_path": d.get("transcript_path"),
                "model": (d.get("model") or {}).get("id"),
                "context_pct": cw.get("used_percentage"),
                "five_hour": rl.get("five_hour") or None,
                "seven_day": rl.get("seven_day") or None,
                "cmux": {k: os.environ.get(v) for k, v in (
                    ("surface", "CMUX_SURFACE_ID"), ("workspace", "CMUX_WORKSPACE_ID"),
                    ("window", "CMUX_WINDOW_ID"), ("claude_pid", "CMUX_CLAUDE_PID")) if os.environ.get(v)},
                "tmux_pane": os.environ.get("TMUX_PANE"),
            }
            sd = sessions_dir()
            sd.mkdir(parents=True, exist_ok=True)
            fd, tmp = tempfile.mkstemp(prefix=sid + ".", dir=sd)
            with os.fdopen(fd, "w") as f:
                json.dump(rec, f)
            os.chmod(tmp, 0o600)
            os.replace(tmp, sd / f"{sid}.json")
    except Exception:
        pass
    try:
        orig = json.loads(statusline_record().read_text()).get("command")
    except Exception:
        orig = None
    out = ""
    if orig:
        try:
            p = subprocess.run(orig, shell=True, input=raw, capture_output=True, text=True, timeout=20)
            out = p.stdout
        except Exception:
            out = ""
    try:
        if tee_config().get("account"):
            seg = hud_segment()
            if seg:
                first, nl, rest = out.partition("\n")
                out = first.rstrip("\r") + seg + nl + rest if out else seg.lstrip() + "\n"
    except Exception:
        pass
    sys.stdout.write(out)
    sys.stdout.flush()
    return 0


def tee_config_path() -> Path:
    return index_path().parent / "tee.json"


def tee_config() -> dict:
    try:
        return json.loads(tee_config_path().read_text())
    except (OSError, ValueError):
        return {}


def live_account(index: dict | None = None) -> tuple[str | None, str | None, bool]:
    """(email, alias, verified): the slot whose token hash equals the live token's,
    else the label from .claude.json unverified."""
    index = load_index() if index is None else index
    try:
        raw = kc_read(LIVE_SERVICE)
        live = json.loads(raw)["claudeAiOauth"]["refreshToken"] if raw else ""
    except (Fail, ValueError, KeyError, TypeError):
        live = ""
    if live:
        h = sha256_hex(live)
        for email, m in index["slots"].items():
            if m.get("token_hash") == h:
                return email, m.get("alias"), True
    label = current_email()
    return label, (index["slots"].get(label) or {}).get("alias") if label else None, False


def hud_segment(index: dict | None = None) -> str:
    email, alias, ok = live_account(index)
    if not email:
        return ""
    text = email + (f" ({alias})" if alias else "") + ("" if ok else " ?")
    return f" \x1b[2m│\x1b[0m \x1b[35m{text}\x1b[0m"


def live_sessions(max_age: int = 90) -> list[dict]:
    """Every session whose feed was updated within `max_age` seconds."""
    out = []
    now = int(dt.datetime.now(dt.timezone.utc).timestamp())
    sd = sessions_dir()
    if not sd.exists():
        return out
    for f in sd.glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if now - int(d.get("ts") or 0) <= max_age:
            out.append(d)
        elif now - int(d.get("ts") or 0) > 7 * 86400:
            try:
                f.unlink()
            except OSError:
                pass
    return sorted(out, key=lambda d: d.get("ts") or 0, reverse=True)


def current_usage(sessions: list[dict], since: int = 0) -> tuple[float | None, dict | None]:
    """The freshest five-hour percentage reported after `since`, with its window."""
    for s in sessions:
        if (s.get("ts") or 0) < since:
            continue
        w = s.get("five_hour") or {}
        pct = w.get("used_percentage")
        if isinstance(pct, (int, float)):
            return float(pct), w
    return None, None


# ----------------------------------------------------------------------------- watch: compaction

def compact_methods(spec: str) -> list[str]:
    methods = [m.strip() for m in spec.split(",") if m.strip()]
    for m in methods:
        if m not in ("native", "cmux") and not m.startswith("cmd:"):
            raise Fail(f"unknown compaction method '{m}': use native, cmux or cmd:<command>")
    return methods


def apply_native_threshold(pct: int | None) -> bool:
    """Set (or clear, with None) CLAUDE_AUTOCOMPACT_PCT_OVERRIDE in the settings env
    block, so every session started afterwards compacts itself at `pct`. Returns
    whether the file changed."""
    sp = settings_path()
    try:
        d = json.loads(sp.read_text()) if sp.exists() else {}
    except ValueError:
        raise Fail(f"{sp} is not valid JSON; not touching it")
    env = d.get("env") if isinstance(d.get("env"), dict) else {}
    before = env.get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE")
    if pct is None:
        env.pop("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", None)
    else:
        env["CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"] = str(int(pct))
    if (env.get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE")) == before:
        return False
    if env:
        d["env"] = env
    else:
        d.pop("env", None)
    _write_json_atomic(sp, d)
    return True


def _write_json_atomic(p: Path, d: dict) -> None:
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=p.name + ".", dir=p.parent)
    with os.fdopen(fd, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    if p.exists():
        os.chmod(tmp, p.stat().st_mode & 0o777)
    os.replace(tmp, p)


def compact_boundaries(transcript: str | None) -> int:
    """How many compactions the transcript records so far."""
    if not transcript or not os.path.exists(transcript):
        return -1
    n = 0
    try:
        with open(transcript, "rb") as f:
            for line in f:
                if b'"compact_boundary"' in line:
                    n += 1
    except OSError:
        return -1
    return n


def cmux_bin() -> str:
    return os.environ.get("CCSWITCH_CMUX") or shutil.which("cmux") or "/Applications/cmux.app/Contents/Resources/bin/cmux"


def send_compact(session: dict, methods: list[str], force: bool, log) -> bool:
    """Ask one running session to compact, through every runtime method. Returns
    whether any method was actually delivered."""
    sent = False
    for m in methods:
        if m == "native":
            continue  # install-time: the session compacts itself
        if m == "cmux":
            c = session.get("cmux") or {}
            if not c.get("surface"):
                log(f"  {session['session_id'][:8]}: no cmux surface recorded; skipping cmux")
                continue
            target = ["--surface", c["surface"]] + (["--workspace", c["workspace"]] if c.get("workspace") else [])
            extra = ["--force"] if force else []
            p = _run([cmux_bin(), "send", *target, *extra, "--", "/compact"], timeout=20)
            if p.returncode == 0:
                import time as _t
                _t.sleep(0.5)
                p = _run([cmux_bin(), "send-key", *target, *extra, "--", "Enter"], timeout=20)
            if p.returncode != 0:
                log(f"  {session['session_id'][:8]}: cmux refused ({(p.stderr or p.stdout).strip()[:120]})")
                continue
            sent = True
        elif m.startswith("cmd:"):
            p = subprocess.run(m[4:], shell=True, input=json.dumps(session), capture_output=True, text=True, timeout=60)
            if p.returncode != 0:
                log(f"  {session['session_id'][:8]}: compaction command exited {p.returncode}")
                continue
            sent = True
    return sent


def wait_compacted(session: dict, before_boundaries: int, before_ctx, timeout: int, log, sleep=None) -> bool:
    """Wait until the transcript records one more compaction, or the session's
    context drops clearly, or the timeout passes."""
    import time as _t
    sleep = sleep or _t.sleep
    deadline = _t.time() + timeout
    sid = session["session_id"]
    while _t.time() < deadline:
        if before_boundaries >= 0 and compact_boundaries(session.get("transcript_path")) > before_boundaries:
            return True
        f = sessions_dir() / f"{sid}.json"
        try:
            cur = json.loads(f.read_text()).get("context_pct")
            if isinstance(cur, (int, float)) and isinstance(before_ctx, (int, float)) and cur <= before_ctx - 10:
                return True
        except (OSError, ValueError):
            pass
        sleep(3)
    log(f"  {sid[:8]}: compaction not confirmed within {timeout}s; going on")
    return False


# ----------------------------------------------------------------------------- watch: the loop

def notify(title: str, text: str) -> None:
    if os.environ.get("CCSWITCH_NO_NOTIFY"):
        return
    try:
        subprocess.run(["osascript", "-e", f'display notification "{text}" with title "{title}"'],
                       capture_output=True, timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def state_path() -> Path:
    return index_path().parent / "watch-state.json"


def load_state() -> dict:
    try:
        return json.loads(state_path().read_text())
    except (OSError, ValueError):
        return {"last_switch_at": 0, "last_compact": {}, "last_notice": {}}


def save_state(st: dict) -> None:
    _write_json_atomic(state_path(), st)


def choose_target(index: dict, current: str | None, switch_at: float) -> list[str]:
    """Candidates ordered by headroom: the slot with the lowest known five-hour
    usage first, a window past its reset counting as empty; slots at or above the
    threshold and the current one are left out."""
    now = dt.datetime.now(dt.timezone.utc)
    ranked = []
    for email, m in index["slots"].items():
        if email == current:
            continue
        w = (m.get("usage") or {}).get("five_hour") or {}
        pct = w.get("utilization")
        reset = w.get("resets_at")
        try:
            past = bool(reset) and dt.datetime.fromisoformat(reset) < now
        except ValueError:
            past = False
        est = 0.0 if (pct is None or past) else float(pct)
        if est >= switch_at:
            continue
        ranked.append((est, m.get("saved_at") or "", email))
    return [e for _, _, e in sorted(ranked)]


def next_target(index: dict) -> str:
    cands = choose_target(index, current_email(), 101)
    if not cands:
        raise Fail("no other slot to switch to")
    return cands[0]


def record_live_usage(index: dict, current: str | None, window: dict | None, weekly: dict | None) -> None:
    """Keep the index's usage for the current account in step with the feed."""
    if not current or current not in index["slots"] or not window:
        return
    def conv(w):
        if not w:
            return None
        r = w.get("resets_at")
        if isinstance(r, (int, float)):
            r = dt.datetime.fromtimestamp(r, dt.timezone.utc).isoformat()
        return {"utilization": w.get("used_percentage"), "resets_at": r}
    u = index["slots"][current].setdefault("usage", {})
    u["five_hour"] = conv(window)
    if weekly:
        u["seven_day"] = conv(weekly)
    u["fetched_at"] = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M")
    u["fetched_at_ms"] = now_ms()


def do_watch(a) -> int:
    import time as _t
    methods = compact_methods(a.compact_via)
    if a.compact_at is not None and "native" in methods and not a.dry_run:
        if apply_native_threshold(a.compact_at):
            say(f"settings: CLAUDE_AUTOCOMPACT_PCT_OVERRIDE={a.compact_at} (applies to sessions started from now)")
    runtime = [m for m in methods if m != "native"]

    def log(msg: str) -> None:
        say(f"{dt.datetime.now().strftime('%H:%M:%S')} {msg}")

    log(f"watch: every {a.interval}s, switch at {a.switch_at}% of the five-hour window"
        + (f", compact at {a.compact_at}% context via {','.join(methods)}" if a.compact_at is not None else ", compaction off")
        + (f", weekly guard {a.weekly_at}%" if a.weekly_at is not None else "")
        + (" [dry run]" if a.dry_run else ""))

    while True:
        st = load_state()
        now = int(_t.time())
        sessions = live_sessions()
        index = load_index()
        cur = current_email()
        pct, window = current_usage(sessions, since=st.get("ignore_before", 0))
        weekly = next((s.get("seven_day") for s in sessions if s.get("seven_day")), None)
        record_live_usage(index, cur, window, weekly)
        if not a.dry_run:
            save_index(index)
            if cur in index["slots"] and not live_account(index)[2]:
                try:
                    do_save(cur, quiet=True)      # the token rotated since the slot was saved
                except Fail:
                    pass

        # per-session compaction at the context threshold
        if a.compact_at is not None and runtime:
            for s in sessions:
                ctx = s.get("context_pct")
                sid = s["session_id"]
                if not isinstance(ctx, (int, float)) or ctx < a.compact_at:
                    continue
                if now - int(st["last_compact"].get(sid, 0)) < a.compact_cooldown:
                    continue
                log(f"session {sid[:8]} at {ctx:.0f}% context: compacting")
                if not a.dry_run and send_compact(s, runtime, a.force, log):
                    st["last_compact"][sid] = now
            save_state(st) if not a.dry_run else None

        # the account switch at the usage threshold
        weekly_pct = (weekly or {}).get("used_percentage") if weekly else None
        over = (pct is not None and pct >= a.switch_at) or \
               (a.weekly_at is not None and isinstance(weekly_pct, (int, float)) and weekly_pct >= a.weekly_at)
        if pct is None and not sessions:
            log("no live session feed; waiting") if a.verbose else None
        elif over and now - int(st.get("last_switch_at", 0)) < a.cooldown:
            log(f"{pct:.0f}% but within cooldown; waiting") if a.verbose else None
        elif over:
            candidates = choose_target(index, cur, a.switch_at)
            log(f"{cur or '?'} at {pct if pct is not None else '?'}% (weekly {weekly_pct}); candidates: {', '.join(candidates) or 'none'}")
            if not candidates:
                if now - int(st["last_notice"].get("none", 0)) > a.cooldown:
                    notify("ccswitch", "every saved account is at or above the threshold; nothing to switch to")
                    st["last_notice"]["none"] = now
                    save_state(st) if not a.dry_run else None
            else:
                if runtime and sessions:
                    log(f"compacting {len(sessions)} session(s) before the switch")
                    marks = []
                    for s in sessions:
                        if a.dry_run:
                            continue
                        b = compact_boundaries(s.get("transcript_path"))
                        if send_compact(s, runtime, a.force, log):
                            marks.append((s, b, s.get("context_pct")))
                            st["last_compact"][s["session_id"]] = now
                    for s, b, c in marks:
                        wait_compacted(s, b, c, a.compact_timeout, log)
                switched = None
                for target in candidates:
                    if a.dry_run:
                        log(f"would switch {cur} -> {target}")
                        switched = target
                        break
                    rc = do_switch(target, assume_yes=True, probe=False)
                    if rc == 0:
                        switched = target
                        break
                    log(f"switch to {target} failed (rc {rc}); trying the next candidate")
                if switched:
                    st["last_switch_at"] = now
                    st["ignore_before"] = now + 35       # feed samples older than this still show the old account
                    notify("ccswitch", f"{cur or '?'} hit {pct:.0f}%; switched to {switched}")
                    log(f"switched {cur} -> {switched}")
                else:
                    notify("ccswitch", "usage threshold hit but every switch failed; log in: claude auth login --email <addr> && ccswitch save")
                    st["last_notice"]["fail"] = now
                save_state(st) if not a.dry_run else None
        elif a.verbose:
            log(f"{cur or '?'} at {pct if pct is not None else '?'}%, {len(sessions)} session(s)")

        if a.once:
            return 0
        _t.sleep(a.interval)


# ----------------------------------------------------------------------------- daemon (launchd)

LABEL = "com.ccswitch.watch"


def plist_path() -> Path:
    return Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"


def log_path() -> Path:
    return Path.home() / "Library" / "Logs" / "ccswitch.log"


def install_statusline_tee() -> str:
    """Point the settings' status line at the tee, keeping the original command."""
    sp = settings_path()
    try:
        d = json.loads(sp.read_text()) if sp.exists() else {}
    except ValueError:
        raise Fail(f"{sp} is not valid JSON; not touching it")
    me = f"'{Path(__file__).resolve()}' statusline-tee"
    sl = d.get("statusLine") or {}
    cmd = sl.get("command") if isinstance(sl, dict) else None
    if cmd == me:
        return "already installed"
    rec = statusline_record()
    rec.parent.mkdir(parents=True, exist_ok=True)
    _write_json_atomic(rec, {"command": cmd, "type": sl.get("type") if isinstance(sl, dict) else None,
                             "refreshInterval": sl.get("refreshInterval") if isinstance(sl, dict) else None})
    new = dict(sl) if isinstance(sl, dict) else {}
    new.update({"type": "command", "command": me})
    new.setdefault("refreshInterval", 10)
    d["statusLine"] = new
    _write_json_atomic(sp, d)
    return f"installed (original kept in {rec})"


def restore_statusline() -> str:
    sp = settings_path()
    rec = statusline_record()
    if not rec.exists():
        return "nothing to restore"
    saved = json.loads(rec.read_text())
    try:
        d = json.loads(sp.read_text()) if sp.exists() else {}
    except ValueError:
        raise Fail(f"{sp} is not valid JSON; not touching it")
    if saved.get("command"):
        d["statusLine"] = {k: v for k, v in (("type", saved.get("type") or "command"), ("command", saved["command"]),
                                            ("refreshInterval", saved.get("refreshInterval"))) if v is not None}
    else:
        d.pop("statusLine", None)
    _write_json_atomic(sp, d)
    rec.unlink()
    return "restored"


def _plist(args: list[str]) -> str:
    def esc(x: str) -> str:
        return x.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    dirs = []
    for b in (claude_bin(), cmux_bin(), security_bin()):
        w = shutil.which(b) or b
        d = str(Path(w).resolve().parent)
        if d not in dirs:
            dirs.append(d)
    path = ":".join(dirs + ["/usr/local/bin", "/opt/homebrew/bin", "/usr/bin", "/bin"])
    prog = "".join(f"\n      <string>{esc(x)}</string>" for x in [sys.executable, str(Path(__file__).resolve()), "watch", *args])
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key>
  <array>{prog}
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{esc(path)}</string>
    <key>HOME</key><string>{esc(str(Path.home()))}</string>{(chr(10) + '    <key>CLAUDE_CONFIG_DIR</key><string>' + esc(os.environ['CLAUDE_CONFIG_DIR']) + '</string>') if os.environ.get('CLAUDE_CONFIG_DIR') else ''}
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{esc(str(log_path()))}</string>
  <key>StandardErrorPath</key><string>{esc(str(log_path()))}</string>
</dict>
</plist>
"""


def _num(x) -> str:
    return str(int(x)) if float(x).is_integer() else str(x)


def do_daemon(a) -> int:
    uid = os.getuid()
    if a.action == "install":
        watch_args = ["--switch-at", _num(a.switch_at), "--interval", str(a.interval), "--cooldown", str(a.cooldown),
                      "--compact-via", a.compact_via, "--compact-timeout", str(a.compact_timeout)]
        if a.compact_at is not None:
            watch_args += ["--compact-at", _num(a.compact_at)]
        if a.weekly_at is not None:
            watch_args += ["--weekly-at", _num(a.weekly_at)]
        if a.force:
            watch_args.append("--force")
        say(f"status line: {install_statusline_tee()}")
        if a.compact_at is not None and "native" in compact_methods(a.compact_via):
            apply_native_threshold(a.compact_at)
            say(f"settings: CLAUDE_AUTOCOMPACT_PCT_OVERRIDE={a.compact_at}")
        pp = plist_path()
        pp.parent.mkdir(parents=True, exist_ok=True)
        log_path().parent.mkdir(parents=True, exist_ok=True)
        if a.no_launchd:
            pp.write_text(_plist(watch_args))
            say(f"wrote {pp} (not loaded: --no-launchd)")
            return 0
        _run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"])
        pp.write_text(_plist(watch_args))
        p = _run(["launchctl", "bootstrap", f"gui/{uid}", str(pp)])
        if p.returncode != 0:
            raise Fail(f"launchctl bootstrap failed: {(p.stderr or p.stdout).strip()[:200]}")
        say(f"daemon running: {LABEL} (log: {log_path()}); `ccswitch daemon status` to check it")
        return 0
    if a.action == "uninstall":
        if not a.no_launchd:
            _run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"])
        if plist_path().exists():
            plist_path().unlink()
        say(f"status line: {restore_statusline()}")
        if apply_native_threshold(None):
            say("settings: CLAUDE_AUTOCOMPACT_PCT_OVERRIDE removed")
        say("daemon removed")
        return 0
    if a.action == "status":
        p = _run(["launchctl", "print", f"gui/{uid}/{LABEL}"])
        if p.returncode != 0:
            print("daemon: not loaded")
        else:
            m = re.search(r"state = (\w+)", p.stdout)
            pid = re.search(r"pid = (\d+)", p.stdout)
            print(f"daemon: {m.group(1) if m else 'loaded'}" + (f" (pid {pid.group(1)})" if pid else ""))
        print(f"plist : {plist_path()} ({'present' if plist_path().exists() else 'absent'})")
        print(f"tee   : {'installed' if statusline_record().exists() else 'not installed'}")
        print(f"feed  : {len(live_sessions())} live session(s)")
        for s in live_sessions():
            fh = (s.get("five_hour") or {}).get("used_percentage")
            print(f"  {s['session_id'][:8]}  ctx {s.get('context_pct') or '?'}%  5h {fh if fh is not None else '?'}%  {s.get('cwd') or ''}")
        st = load_state()
        if st.get("last_switch_at"):
            print(f"last switch: {iso(st['last_switch_at'] * 1000)}")
        return 0
    if a.action == "log":
        p = _run(["tail", "-n", str(a.lines), str(log_path())])
        print(p.stdout, end="")
        return 0
    return 1


def do_hud(action: str) -> int:
    cfg = tee_config()
    if action == "on":
        msg = install_statusline_tee()
        cfg["account"] = True
        _write_json_atomic(tee_config_path(), cfg)
        say(f"status line: {msg}; the account now shows at the end of the first HUD line")
        return 0
    if action == "off":
        cfg["account"] = False
        _write_json_atomic(tee_config_path(), cfg)
        if not plist_path().exists():
            say(f"status line: {restore_statusline()}")
        else:
            say("account segment off; the tee stays because the daemon uses it")
        return 0
    email, alias, ok = live_account()
    print(f"account segment: {'on' if cfg.get('account') else 'off'}; tee: {'installed' if statusline_record().exists() else 'not installed'}")
    print(f"live: {email or '(nobody)'}" + (f" ({alias})" if alias else "") + ("" if ok else "  [label only, token not matched to a slot; run: ccswitch save]"))
    return 0


# ----------------------------------------------------------------------------- main

def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="ccswitch",
        description="Switch the Claude Code login between your own accounts, no browser, no restart.",
        epilog="`ccswitch <target>` is `ccswitch switch <target>`; a bare `ccswitch` lists the slots.",
    )
    ap.add_argument("--version", action="version", version=f"ccswitch {VERSION}")
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("save", help="snapshot the current login into its slot")
    s.add_argument("--as", dest="as_email", help="the email to file it under, when status cannot tell")
    s = sub.add_parser("switch", help="load a slot into the live login (email, unique prefix, number from `list`, or `next`)")
    s.add_argument("name")
    s.add_argument("-y", "--yes", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("-i", "--ask", action="store_true", help="show the slot and ask before switching")
    s.add_argument("--probe", action="store_true", help="send one tiny request afterwards to prove the token works")
    sub.add_parser("list", help="the saved slots with their last known usage")
    sub.add_parser("status", help="who is logged in now, and the cached usage bars")
    s = sub.add_parser("login", help="run the real `claude auth login --email`, then save the slot")
    s.add_argument("email")
    s = sub.add_parser("remove", help="forget a slot")
    s.add_argument("name")
    s.add_argument("-y", "--yes", action="store_true")
    sub.add_parser("doctor", help="check the Keychain items, the index and every slot")
    s = sub.add_parser("alias", help="name a slot: `alias <name> <email|prefix|number>`; no arguments lists them")
    s.add_argument("name", nargs="?")
    s.add_argument("target", nargs="?")
    s = sub.add_parser("unalias", help="drop an alias")
    s.add_argument("name")
    s = sub.add_parser("hud", help="on | off | status: show the live account at the end of the claude-hud line")
    s.add_argument("action", nargs="?", choices=["on", "off", "status"], default="status")
    sub.add_parser("statusline-tee", help="(internal) the status-line command that records the usage feed")

    def watch_args(sp):
        sp.add_argument("--switch-at", type=float, default=90, help="five-hour usage %% at which to switch (default 90)")
        sp.add_argument("--compact-at", type=float, default=None, help="context %% at which a session is compacted (off unless given)")
        sp.add_argument("--compact-via", default="native,cmux",
                        help="comma list of native, cmux, cmd:<command> (default native,cmux)")
        sp.add_argument("--weekly-at", type=float, default=None, help="also switch when the weekly window reaches this %%")
        sp.add_argument("--interval", type=int, default=300,
                        help="seconds between checks of usage and context (default 300 = every 5 minutes)")
        sp.add_argument("--cooldown", type=int, default=300, help="seconds after a switch before another (default 300)")
        sp.add_argument("--compact-cooldown", type=int, default=600, help="seconds before the same session is compacted again")
        sp.add_argument("--compact-timeout", type=int, default=180, help="seconds to wait for a compaction before switching anyway")
        sp.add_argument("--force", action="store_true", help="let cmux type into a session even when a dialog is open")

    s = sub.add_parser("watch", help="the daemon loop, in the foreground")
    watch_args(s)
    s.add_argument("--once", action="store_true", help="one pass, then exit")
    s.add_argument("--dry-run", action="store_true", help="decide and log, change nothing")
    s.add_argument("-v", "--verbose", action="store_true")
    s = sub.add_parser("daemon", help="install | uninstall | status | log the launchd agent")
    s.add_argument("action", choices=["install", "uninstall", "status", "log"])
    watch_args(s)
    s.add_argument("--no-launchd", action="store_true", help="write the plist but do not load it")
    s.add_argument("--lines", type=int, default=40)

    argv = sys.argv[1:] if argv is None else argv
    known = (RESERVED - {"next"}) | {"-h", "--help", "--version"}   # `next` is a switch target
    if argv and argv[0] not in known and not argv[0].startswith("-"):
        argv = ["switch"] + argv
    a = ap.parse_args(argv)
    try:
        if a.cmd == "save":
            do_save(a.as_email)
            return 0
        if a.cmd == "switch":
            return do_switch(a.name, a.yes, a.probe, ask=a.ask)
        if a.cmd == "list":
            return do_list()
        if a.cmd == "status":
            return do_status()
        if a.cmd == "login":
            return do_login(a.email)
        if a.cmd == "remove":
            return do_remove(a.name, a.yes)
        if a.cmd == "doctor":
            return do_doctor()
        if a.cmd == "alias":
            return do_alias(a.name, a.target)
        if a.cmd == "unalias":
            return do_unalias(a.name)
        if a.cmd == "hud":
            return do_hud(a.action)
        if a.cmd == "statusline-tee":
            return do_statusline_tee()
        if a.cmd == "watch":
            return do_watch(a)
        if a.cmd == "daemon":
            return do_daemon(a)
        if not argv:
            return do_list()
        ap.print_help()
        return 0
    except Fail as e:
        say(f"ccswitch: {e}")
        return 2
    except subprocess.TimeoutExpired:
        say("ccswitch: a subprocess timed out")
        return 2


if __name__ == "__main__":
    sys.exit(main())
