#!/usr/bin/env python3
"""A fake `claude` for the tests. `auth status --json` reports what the fake Keychain and
~/.claude.json say; `auth login --email X` mints a fresh login for X; `-p` succeeds only
when the live refresh token is usable."""
import json, os, sys, time

KC = os.environ["FAKE_KEYCHAIN"]
CFG = os.path.join(os.environ["HOME"], ".claude.json")
LIVE = "Claude Code-credentials"


def kc():
    try:
        return json.load(open(KC))
    except (OSError, ValueError):
        return {}


def live():
    items = kc().get(LIVE, {})
    return json.loads(next(iter(items.values()))) if items else None


def cfg():
    try:
        return json.load(open(CFG))
    except (OSError, ValueError):
        return {}


def main(a):
    if a[:2] == ["auth", "status"]:
        l, c = live(), cfg()
        oa = c.get("oauthAccount") or {}
        ok = bool(l and l["claudeAiOauth"].get("refreshToken"))
        print(json.dumps({"loggedIn": ok, "email": oa.get("emailAddress") if ok else None,
                          "orgName": oa.get("organizationName"), "subscriptionType": l["claudeAiOauth"].get("subscriptionType") if l else None}))
        return 0
    if a[:2] == ["auth", "login"]:
        email = os.environ.get("FAKE_CLAUDE_BROWSER_ACCOUNT") or a[a.index("--email") + 1]
        d = kc()
        d.setdefault(LIVE, {})["tester"] = json.dumps({"claudeAiOauth": {
            "accessToken": f"at-{email}-{time.time()}", "refreshToken": f"rt-{email}-{time.time()}",
            "expiresAt": int(time.time() * 1000) + 3600_000, "refreshTokenExpiresAt": int(time.time() * 1000) + 86400_000,
            "scopes": ["user:inference"], "subscriptionType": "max", "rateLimitTier": "default"},
            "organizationUuid": f"org-{email}"})
        json.dump(d, open(KC, "w"))
        c = cfg()
        c["oauthAccount"] = {"emailAddress": email, "organizationName": f"Org of {email}"}
        c["cachedUsageUtilization"] = {"fetchedAtMs": int(time.time() * 1000), "utilization": {
            "five_hour": {"utilization": 7, "resets_at": "2999-01-01T00:00:00+00:00"},
            "seven_day": {"utilization": 42, "resets_at": "2999-01-02T00:00:00+00:00"}}}
        json.dump(c, open(CFG, "w"))
        return 0
    if a and a[0] == "-p":
        l = live()
        return 0 if l and l["claudeAiOauth"]["refreshToken"] and "DEAD" not in l["claudeAiOauth"]["refreshToken"] else 1
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
