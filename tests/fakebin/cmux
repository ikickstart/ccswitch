#!/usr/bin/env python3
"""A fake cmux: logs every call to $FAKE_CMUX_LOG; `send-key ... Enter` on a surface appends a
compact_boundary line to $FAKE_CMUX_TRANSCRIPTS/<surface>.jsonl, as a real compaction would."""
import json, os, sys

args = sys.argv[1:]
with open(os.environ["FAKE_CMUX_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
if os.environ.get("FAKE_CMUX_REFUSE"):
    sys.stderr.write("an agent prompt holds text someone is typing\n")
    sys.exit(1)
if args and args[0] == "send-key" and args[-1] == "Enter":
    surface = args[args.index("--surface") + 1]
    p = os.path.join(os.environ["FAKE_CMUX_TRANSCRIPTS"], surface + ".jsonl")
    with open(p, "a") as f:
        f.write(json.dumps({"type": "system", "subtype": "compact_boundary"}) + "\n")
sys.exit(0)
